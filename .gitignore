# 依赖与构建产物
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# 环境变量 —— 只有 .env.example 进仓库，且不放可用值
.env
.env.*
!.env.example

# 评测集图片不进仓库（含擦边内容，见 docs/eval.md）
# 标注文本是项目核心资产，必须进
docs/fixtures/eval/images/
docs/fixtures/eval/*.png
docs/fixtures/eval/*.jpg
docs/fixtures/eval/*.jpeg
docs/fixtures/eval/*.gif
docs/fixtures/eval/*.webp
# 下划线开头的是校对用的临时工作表，不是资产
docs/fixtures/eval/_*.md

# 本地临时产物
*.log
tmp/
coverage/
.eval-out/

# 唯一一个不进仓库的测试样本：23 MB，且 `npm run fixtures` 可字节一致复现
# 其余 16 个样本合计 1.3 MB，照旧进仓库（见 docs/fixtures.md §2）
docs/fixtures/images/edge/huge.png

# 联调用的替身服务与一次性断言脚本，不是产品代码也不是回归套件
# 依赖替身和联调时点状态，留着是为了下次联调能翻出来看，不是为了长期跑
web/scripts/mock-api.mjs
web/scripts/verify-*.mjs

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
