# Mememio 环境变量样例
#
# 复制成仓库根目录的 .env 再填。清单与语义见 docs/environments.md。
# 这个文件只放字段名和格式说明，不放任何可用值（agents/rules/git-and-delivery.md）。

# ── 命名 ──────────────────────────────────────────────
# 全项目唯一需要改的命名变量，容器 / 卷 / 网络 / 数据库名全由它派生。
# 同一台机器上不能和别的项目重名，见 docs/deployment.md §2。
APP_SLUG=mememio

# ── 数据库 ────────────────────────────────────────────
DB_PASSWORD=<随机生成>

# 注意这里填的是**本机开发**用的连接串，指向 localhost。
# 容器里的 app 不读这一行 —— compose.yaml 给它单独注入 <APP_SLUG>-db:5432 的版本，
# 因为同一个 .env 没法同时表达「宿主机看到的地址」和「容器网络里看到的地址」。
DATABASE_URL=postgres://mememio:<DB_PASSWORD>@localhost:5432/mememio

# ── 密钥 ──────────────────────────────────────────────
SESSION_SECRET=<随机，建议 openssl rand -base64 32>

# 🔴 必须正好 32 字节。它加密所有用户配置的 API Key。
#    丢了 = 全部用户 key 永久解不开；泄露比丢失更糟。
#    必须离线单独备份，不要放进 Docker 和数据库备份里。
#    生成：openssl rand -base64 24   （输出 32 个字符 = 32 字节）
CONFIG_ENC_KEY=<正好 32 字节>

# ── 对象存储 ──────────────────────────────────────────
# 完整开通步骤（建 bucket、拿 S3 凭证、开公开访问、配 CORS）见 docs/deployment.md §8。
# R2_ACCOUNT_ID 只填 32 位十六进制那一段，**不要粘整条 endpoint URL** ——
# 粘了不报错，一路错到浏览器 TLS 握手失败。
R2_ACCOUNT_ID=<Cloudflare account id，32 位十六进制>
# S3 凭证来自 R2 账户级的 Manage API Tokens，不是通用 API Tokens 页那个 token value
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
R2_BUCKET=<bucket 名>
# 共用 bucket 时必须设，否则多个项目的对象互相覆盖。必须以 / 结尾。
R2_KEY_PREFIX=mememio/
# bucket 开 Public Access 后拿到的 r2.dev 地址，或绑定的自定义域。
# **必须填**（缺了进程起不来），且**不能带末尾 /**。
# 也不要把 R2_KEY_PREFIX 拼进来 —— 前缀由代码统一加，写两份迟早不一致。
R2_PUBLIC_BASE_URL=<https://pub-xxxx.r2.dev，不带末尾 />

# ── 部署方提供的默认模型配置 ──────────────────────────
# 这一组**可以全空**，进程照常启动，只是降级运行：
#   没有 DEFAULT_VISION_* → 导入仍可用，图片入库为 tagStatus = pending
#   没有 DEFAULT_EMBED_*  → 搜索降级为 OCR + 标签，响应带 degraded: true
# 见 api/agents/rules/env-validation.md §4。
DEFAULT_VISION_BASE_URL=
DEFAULT_VISION_API_KEY=
DEFAULT_VISION_MODEL=
DEFAULT_EMBED_BASE_URL=
DEFAULT_EMBED_API_KEY=
DEFAULT_EMBED_MODEL=

# ── 评测专用视觉供应商（可选）────────────────────────
# 仅供 `api/scripts/eval.ts` 使用。设了就覆盖 DEFAULT_VISION_*，
# 不设则回退到 DEFAULT_VISION_*。
# 三个变量必须同时设或同时留空，只填一两个无效（同 DEFAULT_VISION_* 规则）。
EVAL_VISION_BASE_URL=
EVAL_VISION_API_KEY=
EVAL_VISION_MODEL=
# 可选，三选一：
#   openai           默认。POST /v1/chat/completions，兼容 DeepSeek / Kimi / 智谱 / 硅基流动 / vLLM / Ollama 等
#   openai-responses POST /v1/responses，OpenAI 新端点
#   anthropic        POST /v1/messages，Anthropic Messages API 原生（Claude 原生及兼容网关）
EVAL_VISION_PROTOCOL=

# ── 进程 ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
